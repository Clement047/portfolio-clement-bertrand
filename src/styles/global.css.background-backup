@import url("https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600&display=swap");

:root {
  --background: #03030a;
  --foreground: #f4f2ff;

  --blue: #516bff;
  --purple: #9b5cff;

  --font-main: Arial, Helvetica, sans-serif;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  background: var(--background);
  color: var(--foreground);
  font-family: var(--font-main);
  overflow-x: hidden;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

button {
  font: inherit;
  cursor: pointer;
}

a {
  color: inherit;
  text-decoration: none;
}

::selection {
  background: var(--purple);
  color: white;
}


/* FOND SPATIAL CONTINU — INTRO + PRESENTATION + PROJETS */

html {
  background: #05040e;
}

body {
  position: relative;
  min-height: 100vh;
  background: transparent;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;

  background:
    radial-gradient(
      ellipse 60% 80% at 0% 35%,
      rgba(32, 58, 145, 0.20),
      transparent 75%
    ),
    radial-gradient(
      ellipse 65% 85% at 100% 55%,
      rgba(95, 37, 155, 0.18),
      transparent 75%
    ),
    #05040e;
}

/* La presentation laisse apparaitre le fond commun */
#presentation {
  background: transparent !important;
}

/* Transition lumineuse douce entre les sections */
#presentation::before {
  content: "";
  position: absolute;
  inset: -15% 0;
  pointer-events: none;
  background: linear-gradient(
    to bottom,
    transparent,
    rgba(43, 30, 100, 0.035) 45%,
    transparent
  );
}



/* ===== FOND UNIQUE INTRO + PRESENTATION ===== */

html {
  background: #05040d !important;
}

body {
  position: relative;
  isolation: isolate;
  background: transparent !important;
}

body::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;

  background:
    radial-gradient(
      ellipse 65% 90% at 0% 45%,
      rgba(29, 48, 125, 0.36) 0%,
      transparent 78%
    ),
    radial-gradient(
      ellipse 70% 100% at 100% 50%,
      rgba(86, 32, 145, 0.31) 0%,
      transparent 78%
    ),
    #05040d;
}

/* Les sections partagent le meme fond */
#presentation,
#intro,
.intro,
.presentation {
  background: transparent !important;
  background-image: none !important;
  background-color: transparent !important;
}

#presentation::before {
  display: none !important;
}

