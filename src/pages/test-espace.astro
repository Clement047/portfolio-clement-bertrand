---

import MainLayout from '../layouts/MainLayout.astro';

import ContactLanding from '../components/ContactLanding.astro';

---

<MainLayout title="Galaxie — Aperçu de la scène spatiale">

  <ContactLanding immersive />

  <div id="space-test-canvas"></div><p id="space-test-status">Chargement de la galaxie…</p>

  <a class="space-test-mode" href="/portfolio-2d/">VERSION 2D ↗</a>

</MainLayout>

<style>#space-test-canvas{position:fixed;inset:0;background:#02040c}#space-test-canvas :global(canvas){width:100%;height:100%;display:block}#space-test-status{position:fixed;inset:0;display:grid;place-items:center;padding:30px;background:#030511;color:#c4d6f4;font:13px Arial;z-index:30}.space-test-mode{position:fixed;bottom:26px;right:30px;z-index:100;padding:12px 17px;border:1px solid #7164ac88;background:#090b18e8;color:#d8d4ed;font:10px Arial;letter-spacing:.16em;text-decoration:none}</style>

<script>

import * as THREE from 'three';

import {wheelAdvance,keyAdvance,touchAdvance,initialPixelRatio,createFrameBudget} from '../lib/experience-controls.js';

import {createSpaceExperience} from '../lib/space/experience.js';

import {createCityRenderer,describeCityError} from '../lib/city-render/loading.js';

const status=document.querySelector<HTMLElement>('#space-test-status')!;

async function start(){

 const renderer=createCityRenderer(THREE.WebGLRenderer);renderer.setPixelRatio(initialPixelRatio(innerWidth,innerHeight,devicePixelRatio));renderer.setSize(innerWidth,innerHeight);renderer.outputColorSpace=THREE.SRGBColorSpace;renderer.shadowMap.enabled=true;renderer.shadowMap.autoUpdate=false;

 document.querySelector('#space-test-canvas')!.append(renderer.domElement);

 const experience=createSpaceExperience(renderer,()=>location.assign('/'));

 await experience.prepare();if(import.meta.env.DEV)experience.seek(Math.max(0,Math.min(4.8,Number(new URLSearchParams(location.search).get('progress'))||0)));

 experience.show();status.remove();const clock=new THREE.Clock();const quality=createFrameBudget(renderer.getPixelRatio(),ratio=>{renderer.setPixelRatio(ratio);experience.resize();});

 function animate(){requestAnimationFrame(animate);const dt=clock.getDelta();if(!document.hidden){quality.sample(dt);experience.render(clock.elapsedTime);}}animate();

 window.addEventListener('wheel',e=>{e.preventDefault();experience.scroll(wheelAdvance(e,innerHeight));},{passive:false});

 window.addEventListener('keydown',e=>{if(['ArrowDown','ArrowUp','PageDown','PageUp'].includes(e.key)){e.preventDefault();experience.scroll(keyAdvance(e.key));}});

 let y=0;window.addEventListener('touchstart',e=>y=e.touches[0].clientY,{passive:true});window.addEventListener('touchmove',e=>{e.preventDefault();const current=e.touches[0].clientY;experience.scroll(touchAdvance(y,current));y=current;},{passive:false});

 window.addEventListener('resize',()=>{renderer.setSize(innerWidth,innerHeight);experience.resize();});

}

start().catch(error=>{console.error(error);status.textContent=describeCityError(error);});

</script>

