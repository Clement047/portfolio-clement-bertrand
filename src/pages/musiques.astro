---
import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Studio musical — Clément Bertrand"><div data-music-studio><p class="studio-loading" role="status">Chargement du studio…</p></div><main class="studio-interface"><section class="studio-glass studio-world-cards"><h1>Choisis ton ambiance</h1><p data-studio-status>Préparation du studio…</p><div class="music-list">{[['encounters','Encounters'],['close-to-me','Close to me'],['alone-again','Alone again'],['night-trip','Night trip']].map(([id,title],i)=><button data-track={id} aria-pressed="false"><span class="music-number">0{i+1}</span><strong>{title}</strong><span class="music-play">Écouter ↗</span></button>)}</div></section></main></MainLayout>
<script>import {mountMusicStudio} from '../lib/music-studio.js';function mount(){mountMusicStudio();document.querySelectorAll<HTMLButtonElement>('[data-track]').forEach(button=>button.onclick=()=>{const id=button.dataset.track!;localStorage.setItem('portfolio-track',id);window.dispatchEvent(new CustomEvent('portfolio:select-track',{detail:id}));document.querySelectorAll('[data-track]').forEach(b=>b.setAttribute('aria-pressed',String(b===button)));});}mount();document.addEventListener('astro:page-load',mount);</script>
<style is:global>@font-face{font-family:StudioMurmure;src:url('/fonts/les-murmures/le-murmure.otf')}[data-music-studio]{position:fixed;inset:0;background:#030713}.studio-interface{position:relative;min-height:100svh;pointer-events:none;display:flex;align-items:center;justify-content:flex-end;padding:90px 7vw;box-sizing:border-box}.studio-return{position:fixed;left:30px;top:30px;pointer-events:auto;color:#b9e5ff;background:#07182ddd;border:1px solid #63c9ff;padding:12px 18px;text-decoration:none;font:26px StudioMurmure}.studio-glass{width:min(570px,85vw);padding:30px;border:1px solid #8cb7ff66;background:linear-gradient(140deg,#183c665c,#30124e7a);backdrop-filter:blur(10px);box-shadow:0 0 45px #578cff22,inset 0 0 40px #b0eaff0a;border-radius:18px;color:#d3eeff}.studio-glass h1{font:48px StudioMurmure;margin:0 0 24px;text-shadow:0 0 14px #6576ee}.studio-glass p{font:12px Arial}.music-list{display:grid;grid-template-columns:1fr 1fr;gap:16px}.music-list button{pointer-events:auto;min-height:135px;border-radius:12px!important;background:linear-gradient(135deg,#142e5366,#3d175d77)!important;border:1px solid #9aafff77!important;display:flex;flex-direction:column;align-items:flex-start;color:#d6efff;cursor:pointer;padding:20px}.music-list strong{font:32px StudioMurmure;font-weight:400}.music-number,.music-play{font:11px Arial;color:#9ad4ff}.music-list button[aria-pressed=true]{box-shadow:0 0 23px #558dff66!important;border-color:#7de8ff!important}.music-play{margin-top:auto}@media(max-width:650px){.studio-interface{padding:100px 20px;align-items:flex-end}.studio-glass{padding:20px}.music-list button{min-height:105px}.studio-glass h1{font-size:38px}}.studio-glass{display:flex;flex-direction:column;justify-content:center;overflow:auto;padding:clamp(10px,1.5vw,24px);border-radius:5px;background:linear-gradient(120deg,#07152b80,#24153c80);backdrop-filter:blur(2px);box-shadow:inset 0 0 30px #5c78df22,0 0 20px #427cf933}.studio-glass h1{font-size:clamp(23px,3vw,46px);margin:0 0 12px}.music-list{gap:10px}.music-list button{min-height:75px;padding:12px!important}.music-list strong{font-size:clamp(22px,2.5vw,36px)}.music-number{font-size:10px}.music-play{font-size:10px}.studio-glass.studio-world-cards{position:absolute!important;left:-10000px!important;top:0!important;width:1px!important;height:1px!important;padding:0!important;overflow:hidden;clip-path:inset(50%);background:none;border:0;box-shadow:none;backdrop-filter:none}.studio-interface{pointer-events:none}[data-music-studio] canvas{display:block}.studio-loading{position:absolute;inset:0;display:grid;place-items:center;margin:0;color:#c6d8ee;font:15px PortfolioMabry,sans-serif;letter-spacing:.04em}.studio-loading[hidden]{display:none}
[data-music-studio]{position:fixed!important;inset:0!important}.studio-interface{position:fixed!important;inset:0;height:100svh;min-height:0}
</style>
