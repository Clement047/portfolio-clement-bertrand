<div class="space-backdrop" data-space-backdrop aria-hidden="true"></div>
<style>.space-backdrop{position:fixed;inset:0;z-index:-1;pointer-events:none;background:#02040c}.space-backdrop :global(canvas){display:block;width:100%;height:100%}</style>
<script>
function mountBackdrop(){for(const host of document.querySelectorAll<HTMLElement>('[data-space-backdrop]')){
 if(host.dataset.ready)continue;host.dataset.ready='true';if(document.querySelector('[data-earth-moon]')){host.remove();continue;}
 let disposed=false,cleanup:(()=>void)|undefined;const observer=new IntersectionObserver(entries=>{if(!entries.some(e=>e.isIntersecting))return;observer.disconnect();import('../lib/space/backdrop.js').then(async({createSpaceBackdrop})=>{if(disposed)return;const close=await createSpaceBackdrop(host);if(disposed)close?.();else cleanup=close;}).catch(console.warn);},{rootMargin:'200px'});observer.observe(host.closest('section')||host);
 document.addEventListener('astro:before-swap',()=>{disposed=true;observer.disconnect();cleanup?.();},{once:true});
}}
mountBackdrop();document.addEventListener('astro:page-load',mountBackdrop);
</script>
