<div id="layer-723-1429" data-node-id="723:1429" style="position:absolute;background-color:#fff;height:3.735px;left:140px;top:1988px;width:127px">
</div>
<p id="layer-723-1430" data-node-id="723:1430" style="word-break:break-word;position:absolute;font-family:'Le Murmure';font-weight:400;height:215px;line-height:normal;left:141px;font-style:normal;font-size:64px;color:#fff;top:2014px;letter-spacing:1.28px;width:445px">Un même lieu, deux présences</p>
