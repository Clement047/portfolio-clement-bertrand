<script>import {initPortfolioAudio} from '../lib/portfolio-audio.js';initPortfolioAudio();</script>
<style is:global>.portfolio-sound-toggle{position:fixed;bottom:28px;left:30px;z-index:100002;background:#071222c9;color:#a9dfff;border:1px solid #5286a8;padding:9px 12px;font:11px Arial;cursor:pointer}</style>
<style is:global>@font-face{font-family:PortfolioControl;src:url('/fonts/les-murmures/le-murmure.otf');font-display:swap}
body button:not(#city-enter):not([data-track]):not([data-contact-control]):not(.portfolio-sound-toggle),body a[class*="mode-switch"]:not(.city-mode-switch),body .space-ui button,body .portfolio-sound-toggle{background:#06182cdd!important;border:1px solid #63c9ff!important;border-radius:0!important;color:#b5eaff!important;padding:14px 20px!important;font:26px PortfolioControl,sans-serif!important;letter-spacing:normal!important;box-shadow:0 0 15px #418dff33!important;cursor:pointer;background-clip:border-box!important;-webkit-background-clip:border-box!important;text-decoration:none;transition:background .2s,box-shadow .2s}
body button:not(#city-enter):not([data-contact-control]):not(.portfolio-sound-toggle):hover,body a[class*="mode-switch"]:not(.city-mode-switch):hover{background:#102e4cee!important;box-shadow:0 0 22px #418dff66!important}body button:focus-visible{outline:2px solid #a7efff;outline-offset:4px}
</style>
<style is:global>
body .portfolio-sound-toggle{position:fixed!important;left:30px!important;bottom:26px!important;right:auto!important;top:auto!important;z-index:100002!important}
.portfolio-music-choice{position:fixed;right:30px;bottom:94px;z-index:100001;background:#06182cdd;border:1px solid #63c9ff;color:#b5eaff;padding:14px 20px;font:26px PortfolioControl,sans-serif;box-shadow:0 0 15px #418dff33;text-decoration:none;transition:background .2s,box-shadow .2s}
.portfolio-music-choice:hover{background:#102e4cee;box-shadow:0 0 22px #418dff66}
.portfolio-music-choice:focus-visible{outline:2px solid #a7efff;outline-offset:4px}
@media(max-width:600px){body .portfolio-sound-toggle{left:15px!important;bottom:20px!important}.portfolio-music-choice{right:15px;bottom:90px;font-size:23px}}
</style>
<style is:global>
@font-face{font-family:PortfolioMabry;src:url('/fonts/project-pages/mabry-pro-light.ttf') format('truetype');font-display:swap}
body a.city-mode-switch,body a.city-mode-switch:hover{background:transparent!important;border:0!important;border-radius:0!important;box-shadow:none!important;padding:10px 0!important;font:16px PortfolioMabry,sans-serif!important;letter-spacing:normal!important;color:#cbdfff!important;filter:none!important;backdrop-filter:none!important;transform:none!important;text-shadow:none}
body a.city-mode-switch:hover{color:#bba3ff!important;text-shadow:0 0 15px #8372f9}
body button.portfolio-sound-toggle:not(#city-enter),body button.portfolio-sound-toggle:not(#city-enter):hover{display:grid!important;place-items:center;width:44px!important;height:44px!important;padding:8px!important;background:transparent!important;border:0!important;box-shadow:none!important;color:#d2e8ff!important;filter:drop-shadow(0 0 7px #3976d6)}
.sound-spectrum{display:flex;align-items:center;justify-content:center;gap:3px;height:24px;width:28px}
.sound-spectrum i{display:block;width:2px;height:14px;min-height:9px;background:currentColor;border-radius:2px;transform-origin:center;transition:opacity .2s,transform .25s}
.sound-spectrum i:nth-child(2n){height:20px}.sound-spectrum i:nth-child(3n){height:14px}.sound-spectrum i:nth-child(4){height:24px}
.portfolio-sound-toggle[data-muted="true"] .sound-spectrum i{opacity:.5;transform:scaleY(.18)}
.portfolio-sound-toggle:is(:hover,:focus-visible) .sound-spectrum i{animation:sound-spectrum-hover .65s ease-in-out infinite alternate;animation-delay:calc(var(--bar)*-.12s)}
@keyframes sound-spectrum-hover{from{transform:scaleY(.3)}to{transform:scaleY(1)}}
@media(prefers-reduced-motion:reduce){.portfolio-sound-toggle:is(:hover,:focus-visible) .sound-spectrum i{animation:none;transform:scaleY(.8)}}
</style>




