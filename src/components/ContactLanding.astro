---
import contacts from '../data/contact.json';
const { immersive = false } = Astro.props;
const [mail,instagram,linkedin]=contacts;
const stars=[{"x": 487.0, "y": 16.559999999999945, "width": 20.873, "height": 20.873, "src": "/images/contact-final/57d66158-c89b-437c-9a41-a4b07e5ef17b.svg", "node": "334:21"}, {"x": 584.0, "y": 136.0, "width": 20.873, "height": 20.873, "src": "/images/contact-final/57d66158-c89b-437c-9a41-a4b07e5ef17b.svg", "node": "334:24"}, {"x": 302.0, "y": 61.0, "width": 12.0, "height": 12.0, "src": "/images/contact-final/5b2279e8-113b-42b8-aa38-8497f5ae2656.svg", "node": "334:27"}, {"x": 122.0, "y": 61.0, "width": 20.0, "height": 20.0, "src": "/images/contact-final/f689eaa3-479b-4793-83a3-3b2516d008ff.svg", "node": "334:42"}, {"x": 1014.0, "y": 38.0, "width": 43.945, "height": 204.945, "src": "/images/contact-final/112b3d0b-d006-4393-a4b9-c7bce10fd165.svg", "node": "334:57"}, {"x": 1237.0, "y": 83.0, "width": 12.0, "height": 12.0, "src": "/images/contact-final/5b2279e8-113b-42b8-aa38-8497f5ae2656.svg", "node": "334:81"}, {"x": 372.0, "y": 92.59999999999991, "width": 555.0, "height": 123.525, "src": "/images/contact-final/4a6b7071-5232-4303-9894-d0a390f032ed.svg", "node": "334:84"}, {"x": 777.0, "y": 7.0, "width": 12.0, "height": 12.0, "src": "/images/contact-final/5b2279e8-113b-42b8-aa38-8497f5ae2656.svg", "node": "334:98"}, {"x": 772.0, "y": 221.0, "width": 12.0, "height": 12.0, "src": "/images/contact-final/5b2279e8-113b-42b8-aa38-8497f5ae2656.svg", "node": "334:103"}];
---
<section id="contact" class:list={['contact-landing',{'contact-landing--immersive':immersive}]} data-contact-landing={immersive?'':undefined} hidden={immersive} aria-label="Contact">
 {immersive && <button class="contact-back" data-contact-back>↑ Revenir aux projets</button>}
 <div class="contact-design-wrap"><div class="contact-artboard" data-figma-file="VhiGuWfgYkPDTIAS57lBhf" data-design-width="1440" data-design-height="560">
  <img class="contact-terrain" src="/images/contact-final/9a336ab5-34a2-4eae-a43f-ef9d891c43cb.png" alt="" decoding="async" data-node-id="334:20" />
  {stars.map(star=><img class="contact-star" src={star.src} alt="" style={`left:${star.x}px;top:${star.y}px;width:${star.width}px;height:auto`} data-node-id={star.node} />)}
  <h2 data-node-id="334:101">Et si on créait quelque chose ensemble ?</h2>
  <a class="contact-cta" href={mail.href} aria-label={`Me contacter : ${mail.label}`} data-node-id="334:102"><img src="/images/contact-final/6153bea4-a19d-4500-abd8-757f195f1cac.svg" alt="" /><span>Me contacter</span></a>
  <p class="contact-credit" data-node-id="438:429">© 2026 CLÉMENT BERTRAND</p><p class="contact-degree" data-node-id="438:430">Portfolio réalisé dans le cadre du BUT MMI</p>
  <a class="contact-home crop" href="/portfolio-2d/" aria-label="Accueil du portfolio 2D" data-node-id="438:432"><img src="/images/contact-final/be59a52c-4069-4e99-a4a3-0e6144a0cc67.png" alt="" /></a>
  <a class="contact-mail crop" href={mail.href} aria-label={mail.label}><img src={mail.icon} alt="E-mail" /></a>
  <a class="contact-instagram crop" href={instagram.href} target="_blank" rel="noopener noreferrer" aria-label={`Instagram : ${instagram.label}`}><img src={instagram.icon} alt="Instagram" /></a>
  <a class="contact-linkedin crop" href={linkedin.href} target="_blank" rel="noopener noreferrer" aria-label={`LinkedIn : ${linkedin.label}`}><img src={linkedin.icon} alt="LinkedIn" /></a>
 </div></div>
</section>
<style>
@font-face{font-family:ContactMurmure;src:url('/fonts/les-murmures/le-murmure.otf')}@font-face{font-family:ContactJersey;src:url('/fonts/project-pages/jersey-10.ttf')}
.contact-landing{position:relative;isolation:isolate;background:#000220;color:#fff;overflow:hidden}.contact-landing[hidden]{display:none}.contact-landing--immersive{position:fixed;inset:0;z-index:80;opacity:0;pointer-events:none}.contact-design-wrap{width:100%;height:38.8889vw;position:relative}.contact-landing--immersive .contact-design-wrap{position:absolute;bottom:0}.contact-artboard{position:absolute;left:0;top:0;width:1440px;height:560px;transform:scale(var(--contact-scale,1));transform-origin:0 0;background:#000220;overflow:hidden}.contact-terrain{position:absolute;inset:0;width:1440px;height:560px;max-width:none}.contact-star{position:absolute;max-width:none;pointer-events:none}.contact-artboard h2{position:absolute;left:245px;top:101px;width:978px;height:76px;font:86.367px/normal ContactMurmure;letter-spacing:1.7273px;margin:0;font-weight:400}.contact-cta{position:absolute;left:585px;top:213px;width:277px;height:89.811px;display:block}.contact-cta>img{position:absolute;inset:0;width:277px;height:auto;max-width:none}.contact-cta span{position:absolute;left:53px;top:21px;white-space:nowrap;font:37.529px/normal ContactJersey;color:#4cfafa}.contact-credit,.contact-degree{position:absolute;left:29px;font:24px/normal ContactJersey;color:#4cfafa;margin:0}.contact-credit{top:479.088px}.contact-degree{top:507.874px}.crop{display:block;position:absolute;overflow:hidden}.crop img{position:absolute;max-width:none;pointer-events:none}.contact-home{left:672px;top:456px;width:126px;height:78px}.contact-home img{width:146.01%;height:156.81%;left:-24.43%;top:-26.95%}.contact-mail{left:1229px;top:490.305px;width:59.005px;height:43.69px}.contact-mail img{width:164.54%;height:173.4%;left:-33.6%;top:-37.09%}.contact-instagram{left:1364.51px;top:485.936px;width:52.481px;height:49.064px}.contact-instagram img{width:148.15%;height:143.1%;left:-25.36%;top:-21.97%}.contact-linkedin{left:1301.709px;top:485.233px;width:52.291px;height:52.767px}.contact-linkedin img{width:182.31%;height:144.59%;left:-42.65%;top:-25.64%}.contact-back{position:absolute;top:28px;left:35px;z-index:3;background:#060b20;border:1px solid #576593;color:#c8dfff;padding:10px 16px;cursor:pointer}a:focus-visible{outline:3px solid #4cfafa;outline-offset:5px}
</style>
<script>
const contactSection=document.querySelector('.contact-landing');if(contactSection)new IntersectionObserver(entries=>{document.documentElement.classList.toggle('contact-in-view',entries.some(e=>e.isIntersecting));},{threshold:.1}).observe(contactSection);
for(const wrap of document.querySelectorAll<HTMLElement>('.contact-design-wrap')){const board=wrap.querySelector<HTMLElement>('.contact-artboard')!;const resize=()=>{const w=wrap.getBoundingClientRect().width;if(w>0){board.style.setProperty('--contact-scale',String(w/1440));wrap.style.height=`${w*560/1440}px`;}};new ResizeObserver(resize).observe(wrap);resize();}
</script>

<style is:global>
html.contact-in-view .city-mode-switch,html.contact-in-view .space-test-mode,html.contact-in-view .original-mode-switch{bottom:auto;top:26px}
</style>
