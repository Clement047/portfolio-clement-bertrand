<div id="black-hole-loader" class="black-hole-loader" aria-label="Chargement du portfolio">
  <canvas id="black-hole-canvas"></canvas>

  <div class="loader-interface">
    <div class="loader-progress">
      <div class="loader-progress__track">
        <div class="loader-progress__fill" id="loader-fill"></div>
        <div class="loader-progress__glitch"></div>
      </div>

      <div class="loader-progress__details">
        <span>INITIALIZING EXPERIENCE</span>
        <span id="loader-percentage">00%</span>
      </div>
    </div>
  </div>
</div>

<script>
  import * as THREE from 'three';
  import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';

  function startBlackHole(){
  const overlay = document.getElementById('black-hole-loader');
  const canvas = document.getElementById('black-hole-canvas');
  const fill = document.getElementById('loader-fill');
  const percentage = document.getElementById('loader-percentage');

  if (overlay && canvas && fill && percentage) {
    const scene = new THREE.Scene();

    const camera = new THREE.PerspectiveCamera(
      40,
      window.innerWidth / window.innerHeight,
      0.1,
      1000
    );

    camera.position.set(0, 0, 9);

    let renderer: THREE.WebGLRenderer;
    try { renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true
    }); } catch { overlay.remove(); return; }

    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(window.innerWidth, window.innerHeight);

    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;

    scene.add(new THREE.AmbientLight(0xffffff, 0.65));

    const blueLight = new THREE.PointLight(0x526dff, 45);
    blueLight.position.set(-4, 2, 5);
    scene.add(blueLight);

    const purpleLight = new THREE.PointLight(0x9b5cff, 35);
    purpleLight.position.set(4, -2, 3);
    scene.add(purpleLight);

    const loader = new GLTFLoader();

    let blackHole = null;
    let progress = 0;
    let targetProgress = 0;
    let finished = false;
    let disposed = false;

    const MIN_LOADING_TIME = 700;
    const loadingStart = performance.now();

    const clock = new THREE.Clock();

    function updateProgress(value) {
      targetProgress = Math.max(targetProgress, Math.min(100, value));
    }

    loader.load(
      '/models/black_hole.glb',

      (gltf) => {
        blackHole = gltf.scene;
        scene.add(blackHole);

        // Adapter automatiquement le modèle à l'écran
        const bounds = new THREE.Box3().setFromObject(blackHole);
        const center = bounds.getCenter(new THREE.Vector3());
        const size = bounds.getSize(new THREE.Vector3());

        blackHole.position.sub(center);

        const maxDimension = Math.max(size.x, size.y, size.z);

        if (maxDimension > 0) {
          const scale = 8 / maxDimension;
          blackHole.scale.setScalar(scale);
          blackHole.position.multiplyScalar(scale);

          // Orientation plus frontale
          blackHole.rotation.x = -0.35;
          blackHole.rotation.z = -0.12;
        }

        updateProgress(100);
      },

      (event) => {
        if (event.total > 0) {
          updateProgress((event.loaded / event.total) * 90);
        }
      },

      (error) => {
        console.error('Erreur chargement black_hole.glb', error);
        updateProgress(100);
      }
    );

    function resize() {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();

      renderer.setSize(window.innerWidth, window.innerHeight);
    }

    window.addEventListener('resize', resize);

    function animate() {
      if (disposed) return;

      requestAnimationFrame(animate);

      const dt = Math.min(clock.getDelta(), 0.05);
      const elapsed = clock.elapsedTime;

      const elapsedLoading = performance.now() - loadingStart;

      // Progression cinématographique sur 10 secondes
      const timeProgress = Math.min(
        elapsedLoading / MIN_LOADING_TIME,
        1
      );

      // Ralentissement progressif vers 100 %
      const easedProgress = 1 - Math.pow(1 - timeProgress, 2.5);

      // Tant que le modèle n'est pas prêt, on reste sous 99 %
      const maximumProgress =
        targetProgress >= 100 ? 100 : 99;

      progress = Math.min(
        easedProgress * 100,
        maximumProgress
      );

      if (
        elapsedLoading >= MIN_LOADING_TIME &&
        targetProgress >= 100
      ) {
        progress = 100;
      }

      fill.style.width = `${progress}%`;
      percentage.textContent =
        `${Math.floor(progress).toString().padStart(2, '0')}%`;

      if (blackHole) {
        blackHole.rotation.y += dt * 0.018;
        blackHole.rotation.z = -0.12 + Math.sin(elapsed * 0.12) * 0.015;
      }

      renderer.render(scene, camera);

      if (progress >= 100 && !finished) {
        finished = true;

        setTimeout(() => {
          overlay.classList.add('is-entering');

          setTimeout(() => {
            overlay.remove();
            disposed = true;
            renderer.dispose();
            window.removeEventListener('resize', resize);
          }, 500);
        }, 100);
      }
    }

    animate();
  }
  }
  startBlackHole();
</script>

<style>
  .black-hole-loader {
    position: fixed;
    inset: 0;
    z-index: 99999;
    overflow: hidden;

    background:
      radial-gradient(
        ellipse 55% 55% at 50% 50%,
        rgba(27, 35, 90, .25),
        transparent 75%
      ),
      #010208;

    transition:
      opacity .5s ease,
      visibility .5s ease;
  }

  .black-hole-loader.is-entering {
    opacity: 0;
    visibility: hidden;
  }

  #black-hole-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .loader-interface {
    position: absolute;
    bottom: 14%;
    left: 50%;
    transform: translateX(-50%);
    width: min(440px, 76vw);
    z-index: 2;
  }

  .loader-progress__track {
    position: relative;
    height: 3px;
    overflow: visible;
    background: rgba(125, 135, 190, .15);
  }

  .loader-progress__fill {
    position: relative;
    width: 0;
    height: 100%;

    background: linear-gradient(
      90deg,
      #4469ff,
      #8d4dff,
      #c1b4ff
    );

    box-shadow:
      0 0 8px rgba(110, 100, 255, .8),
      0 0 24px rgba(100, 75, 255, .45);

    transition: width .12s linear;
  }

  .loader-progress__glitch {
    position: absolute;
    inset: -3px 0;
    pointer-events: none;

    background: repeating-linear-gradient(
      90deg,
      transparent 0 18px,
      rgba(200, 185, 255, .28) 19px,
      transparent 21px
    );

    mix-blend-mode: screen;
    animation: loader-glitch 1.6s steps(2, end) infinite;
  }

  .loader-progress__details {
    display: flex;
    justify-content: space-between;
    margin-top: 17px;

    font-family: 'Lexend', sans-serif;
    font-size: 10px;
    font-weight: 300;
    letter-spacing: .18em;

    color: #a5a6c9;
  }

  .black-hole-loader.is-entering #black-hole-canvas {
    animation: black-hole-zoom 1.3s ease-in forwards;
  }

  @keyframes loader-glitch {
    0%, 78%, 100% {
      opacity: .45;
      transform: translateX(0);
    }

    80% {
      opacity: .9;
      transform: translateX(-12px);
    }

    84% {
      transform: translateX(15px);
    }

    88% {
      opacity: .1;
      transform: translateX(-3px);
    }
  }

  @keyframes black-hole-zoom {
    to {
      transform: scale(2.8);
      filter: brightness(2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loader-progress__glitch,
    .black-hole-loader.is-entering #black-hole-canvas {
      animation: none;
    }
  }
</style>



