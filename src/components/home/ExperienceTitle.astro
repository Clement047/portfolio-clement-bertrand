<span class="experience-title" data-experience-title>
  <span class="experience-svg experience-svg-main" role="img" aria-label="Enter the Experience"><img src="/svg/enter-the-experience.svg" alt="" width="1326" height="183" style="display:block;width:100%;height:auto" /></span>
  <img src="/svg/enter-the-experience.svg" alt="" aria-hidden="true" class="experience-svg glitch-layer glitch-blue" draggable="false" />
  <img src="/svg/enter-the-experience.svg" alt="" aria-hidden="true" class="experience-svg glitch-layer glitch-purple" draggable="false" />
</span>
<style>  /* SVG */

  .experience-title {
    position: relative;
    width: min(100%, 1150px);
    margin: 0 auto;
    isolation: isolate;
    cursor: crosshair;
    transform: translateZ(0);
  }

  .experience-svg {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
    pointer-events: none;
  }

  .experience-svg-main {
    position: relative;
    z-index: 3;
    filter:
      drop-shadow(0 0 12px rgba(115, 105, 255, 0.35))
      drop-shadow(0 0 35px rgba(65, 70, 255, 0.12));
    animation: electric-flicker 8s infinite;
  }

  /* COUCHES GLITCH */

  .glitch-layer {
    position: absolute;
    inset: 0;
    z-index: 2;
    opacity: 0;
    mix-blend-mode: screen;
  }

  .glitch-blue {
    filter: brightness(1.4) sepia(1) saturate(8)
      hue-rotate(165deg);
  }

  .glitch-purple {
    filter: brightness(1.3) sepia(1) saturate(8)
      hue-rotate(225deg);
  }

  .experience-title.is-glitching .glitch-blue {
    opacity: 0.8;
    animation: glitch-blue 180ms steps(2, end) infinite;
  }

  .experience-title.is-glitching .glitch-purple {
    opacity: 0.7;
    animation: glitch-purple 230ms steps(2, end) infinite;
  }

  .experience-title.is-glitching .experience-svg-main {
    animation: glitch-main 160ms steps(2, end) infinite;
  }

  @keyframes glitch-blue {
    0% {
      transform: translate(-4px, 1px);
      clip-path: inset(10% 0 70% 0);
    }

    35% {
      transform: translate(7px, -2px);
      clip-path: inset(55% 0 20% 0);
    }

    70% {
      transform: translate(-8px, 3px);
      clip-path: inset(30% 0 45% 0);
    }

    100% {
      transform: translate(3px, 0);
      clip-path: inset(75% 0 8% 0);
    }
  }

  @keyframes glitch-purple {
    0% {
      transform: translate(5px, -2px);
      clip-path: inset(65% 0 15% 0);
    }

    45% {
      transform: translate(-7px, 2px);
      clip-path: inset(20% 0 60% 0);
    }

    80% {
      transform: translate(9px, -1px);
      clip-path: inset(45% 0 35% 0);
    }

    100% {
      transform: translate(-3px, 1px);
      clip-path: inset(5% 0 80% 0);
    }
  }

  @keyframes glitch-main {
    0%, 100% {
      transform: translate(0);
    }

    25% {
      transform: translate(2px, 0);
    }

    50% {
      transform: translate(-3px, 1px);
    }

    75% {
      transform: translate(1px, -1px);
    }
  }

  @keyframes electric-flicker {
    0%, 89%, 91%, 93%, 100% {
      opacity: 1;
    }

    90%, 92% {
      opacity: 0.65;
    }
  }

.experience-title{display:block;width:100%;margin:0;position:relative}.experience-svg-main :global(svg){display:block;width:100%;height:auto;overflow:visible}.experience-svg-main :global(path){will-change:transform}.experience-svg-main{min-height:1px}
@media(prefers-reduced-motion:reduce){.experience-svg-main,.glitch-layer{animation:none!important}}
</style>
<script>
import { activateElasticTitleWhenVisible } from '../../lib/elastic-title.js';
const reducedMotion=window.matchMedia('(prefers-reduced-motion: reduce)');
for(const title of document.querySelectorAll<HTMLElement>('[data-experience-title]')){
  const main=title.querySelector<HTMLElement>('.experience-svg-main')!;
  let timer:number|undefined,end:number|undefined;
  function glitch(){if(reducedMotion.matches||!title.getClientRects().length)return;title.classList.add('is-glitching');window.clearTimeout(end);end=window.setTimeout(()=>title.classList.remove('is-glitching'),90+Math.random()*230);}
  function schedule(){timer=window.setTimeout(()=>{glitch();schedule();},800+Math.random()*1800);}
  title.addEventListener('pointerenter',glitch);schedule();
  fetch('/svg/enter-the-experience.svg').then(r=>{if(!r.ok)throw Error('SVG unavailable');return r.text();}).then(text=>{
    const doc=new DOMParser().parseFromString(text,'image/svg+xml'),source=doc.querySelector('svg');if(!source||doc.querySelector('parsererror'))return;
    const svg=document.importNode(source,true);svg.setAttribute('width','100%');svg.removeAttribute('height');main.replaceChildren(svg);if(!reducedMotion.matches)activateElasticTitleWhenVisible(svg,title);
  }).catch(console.warn);
  window.addEventListener('pagehide',()=>{window.clearTimeout(timer);window.clearTimeout(end);},{once:true});
}
</script>
