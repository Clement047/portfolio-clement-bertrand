<section class="presentation" id="presentation" aria-label="À propos de Clément Bertrand">
  <div class="presentation-stars" aria-hidden="true"></div>
  <div class="presentation-content">
    <div class="presentation-copy">
      <p>Je m’appelle Clément Bertrand et je suis étudiant en deuxième année de BUT Métiers du Multimédia et de l’Internet (MMI) à l’IUT Nord Franche-Comté.</p>
      <p>Passionné par le cinéma, la musique, je vois ces deux formes d’expressions comme des moyens de transmettre des émotions, de révéler la beauté et la complexité de notre monde, mais aussi de donner vie à des univers qui n’existent que dans notre imagination.</p>
      <p>Entre audiovisuel, 3D et design, j’explore différentes formes de création avec une même ambition : repousser les limites de ma créativité, bousculer les codes et proposer des expériences qui sortent de l’ordinaire.</p>
      <p>Mes influences vont de David Lynch à John Williams, en passant par PNL et Kanye West. Des univers très différents, qui m’inspirent par leur mise en scène, leurs compositions et leur manière de faire dialoguer les images et les sons.<br />Ils m’encouragent à expérimenter et à développer une identité personnelle.</p>
      <p>Je me définirais comme quelqu’un de spirituel, créatif et ambitieux.</p>
    </div>
    <div class="portrait" data-about-avatar>
      <div class="portrait-canvas" data-avatar-canvas role="group" aria-label="Portrait interactif de Clément Bertrand"></div>
      <p class="portrait-help" id="portrait-interaction-hint"><span data-avatar-status aria-live="polite">Chargement du portrait…</span><span data-avatar-fact data-no-translate aria-hidden="true"></span><span class="portrait-announcement" data-avatar-announcement data-no-translate role="status" aria-live="polite" aria-atomic="true"></span></p>
    </div>
  </div>
</section>
<style>
.presentation{position:relative;isolation:isolate;overflow:hidden;background:radial-gradient(ellipse at 12% 20%,#17376177,transparent 65%),radial-gradient(ellipse at 20% 85%,#39185677,transparent 65%),#02040c;color:#e8ecf5;scroll-margin-top:80px}
.presentation-stars{position:absolute;inset:0;z-index:-1;pointer-events:none;background-image:radial-gradient(1px 1px at 19px 39px,#d9e3ff99 70%,transparent),radial-gradient(1px 1px at 113px 117px,#d9e3ff77 70%,transparent),radial-gradient(1px 1px at 221px 72px,#c1ccff66 70%,transparent);background-size:293px 251px,397px 337px,463px 419px}
.presentation-content{position:relative;max-width:1100px;margin:auto;padding:140px 28px 70px;text-align:center}
.presentation-copy{max-width:720px;margin:auto;font-family:PortfolioMabry,sans-serif;font-size:clamp(16px,1.35vw,21px);line-height:1.55;letter-spacing:.015em}
.presentation-copy p{margin:0 0 25px}.presentation-copy p:nth-child(4){margin-top:45px}
.portrait{position:relative;width:min(100%,780px);height:clamp(430px,65vw,680px);margin:20px auto 0}.portrait-canvas{position:absolute;inset:0 0 35px;cursor:pointer;touch-action:pan-y}.portrait-canvas:active{cursor:pointer}.portrait-canvas :global(canvas){display:block;width:100%;height:100%;outline:none}.portrait-canvas :global(canvas:focus-visible){outline:1px solid #91cfff;outline-offset:-4px}
.portrait-help{position:absolute;bottom:clamp(50px,9vw,75px);width:100%;margin:0;color:#dce7f7;font:clamp(20px,2vw,26px)/1.25 PortfolioMabry,sans-serif;pointer-events:none}
.portrait-help [data-avatar-fact]{display:none}.portrait[data-has-fact] [data-avatar-status]{display:none}.portrait[data-has-fact] [data-avatar-fact]{display:block}.portrait[data-has-fact] .portrait-help{box-sizing:border-box;padding:0 18px;top:calc(100% - clamp(50px,9vw,75px) - 1.25em);bottom:auto;line-height:1.4}.portrait[data-has-fact]{margin-bottom:140px}.portrait-announcement{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
@media(max-width:600px){.presentation-content{padding:100px 24px 50px}.presentation-copy{font-size:16px}.portrait{height:470px}.presentation-copy p{margin-bottom:23px}}
</style>
<script>
function mountAbout(){
 const host=document.querySelector<HTMLElement>('[data-about-avatar]');if(!host||host.dataset.mounted)return;host.dataset.mounted='true';
 const lifetime=new AbortController();
 let cancelled=false,dispose:(()=>void)|undefined;
 const observer=new IntersectionObserver(entries=>{if(!entries.some(e=>e.isIntersecting))return;observer.disconnect();import('../../lib/about-avatar.js').then(async({mountAboutAvatar})=>{if(cancelled)return;const cleanup=await mountAboutAvatar(host,{signal:lifetime.signal});if(cancelled)cleanup?.();else dispose=cleanup;}).catch(()=>{const status=host.querySelector('[data-avatar-status]');if(status)status.textContent='Le portrait 3D n’a pas pu être chargé.';});},{rootMargin:'350px'});observer.observe(host);
 document.addEventListener('astro:before-swap',()=>{cancelled=true;lifetime.abort();observer.disconnect();dispose?.();},{once:true});
}
mountAbout();document.addEventListener('astro:page-load',mountAbout);
</script>
<style is:global>
body:has(.earth-hero) #presentation{z-index:2;background:transparent}
body:has(.earth-hero) #presentation .presentation-stars{display:none}
</style>





