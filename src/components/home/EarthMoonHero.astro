---
import ExperienceTitle from './ExperienceTitle.astro';
const links=[['Projets','#project-orbit'],['À propos','#presentation'],['Contact','#contact'],['Studio','/musiques/']];
---

<div class="home-handoff-line" aria-hidden="true"></div><section class="earth-hero" id="intro"><svg aria-hidden="true" width="0" height="0" style="position:absolute;pointer-events:none"><defs><filter id="home-handoff-wave" x="-10%" y="-10%" width="120%" height="120%" color-interpolation-filters="sRGB"><feTurbulence type="fractalNoise" baseFrequency="0.007 0.016" numOctaves="1" seed="4" result="wave"/><feDisplacementMap data-handoff-displacement in="SourceGraphic" in2="wave" scale="0" xChannelSelector="R" yChannelSelector="G"/><feGaussianBlur data-handoff-blur stdDeviation="0"/></filter></defs></svg><div class="earth-hero-sticky"><div data-earth-moon aria-hidden="true"></div><div class="earth-hero-copy"><p><img src="/svg/clement-bertrand.svg" alt="Clément Bertrand" width="1895" height="684" /></p><a href="#project-orbit" aria-label="Découvrir les projets"><ExperienceTitle /></a></div><span class="hero-scroll-mark" aria-hidden="true">↓</span></div></section>
<script>import {mountEarthMoonHero} from '../../lib/earth-moon-hero.js';mountEarthMoonHero();document.addEventListener('astro:page-load',mountEarthMoonHero);</script>
<style>@font-face{font-family:HeroMurmure;src:url('/fonts/les-murmures/le-murmure.otf');font-display:swap}@font-face{font-family:HeroMabry;src:url('/fonts/project-pages/mabry-pro-light.ttf');font-display:swap}.earth-nav{position:fixed;right:5vw;top:28px;display:flex;gap:clamp(18px,3vw,44px);z-index:100003;align-items:center;mix-blend-mode:screen}.earth-nav a{color:#cbdfff;text-decoration:none;font:16px HeroMabry,Arial;min-width:60px;text-align:center;transition:color .2s,text-shadow .2s}.earth-nav a:hover,.earth-nav a:focus-visible{color:#bba3ff;text-shadow:0 0 15px #8372f9}.earth-hero{height:200svh;position:relative;--hero-progress:0;background:#020512}.earth-hero-sticky{position:sticky;top:0;height:100svh;overflow:hidden;isolation:isolate}[data-earth-moon]{position:absolute;inset:0;background:radial-gradient(ellipse at 75% 55%,#32145b66,transparent 55%),#020512;transform:scale(calc(1 + var(--hero-progress)*.08));opacity:1}[data-earth-moon] canvas{display:block}.earth-hero-copy{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:35px;transform:perspective(900px) translateY(calc(var(--hero-progress)*-220px)) rotateX(calc(var(--hero-progress)*48deg)) scale(calc(1 - var(--hero-progress)*.2));opacity:clamp(0,calc(1 - var(--hero-progress)*1.6),1);pointer-events:none}.earth-hero-copy p{font:32px HeroMurmure;color:#d2e8ff;text-shadow:0 0 15px #3166af}.earth-hero-copy a{pointer-events:auto;width:min(80vw,1100px);display:block}.hero-scroll-mark{position:absolute;bottom:35px;left:50%;font-size:24px;color:#aad3ff;opacity:calc(1 - var(--hero-progress))}@media(max-width:600px){.earth-nav{right:20px;left:20px;justify-content:space-between;gap:8px}.earth-nav a{font-size:14px;min-width:0}.earth-hero-copy p{font-size:28px}}@media(prefers-reduced-motion:reduce){.earth-hero{height:100svh}.earth-hero-copy,[data-earth-moon]{transform:none;opacity:1}} .nav-letter{position:relative;display:inline-block;white-space:pre}.nav-original,.nav-alternate{display:inline-block;transition:opacity .18s ease,transform .4s cubic-bezier(.2,.7,.2,1);transition-delay:calc(var(--letter-index)*35ms)}.nav-original{transform:translateY(0) rotate(0)}.nav-alternate{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font:26px HeroMurmure;opacity:0;transform:translateY(70%) rotate(7deg)}.earth-nav a:is(:hover,:focus-visible) .nav-original{opacity:0;transform:translateY(-70%) rotate(-7deg)}.earth-nav a:is(:hover,:focus-visible) .nav-alternate{opacity:1;transform:translateY(0) rotate(0)}@media(prefers-reduced-motion:reduce){.nav-original,.nav-alternate{transition-delay:0ms}}.earth-hero :global(.experience-svg-main){filter:brightness(0) invert(1)!important}.earth-hero[data-webgl-title="true"] :global(.experience-title){display:none}.earth-hero-copy p{position:absolute;top:28%;margin:0}.earth-hero-copy a{position:absolute;top:35%;aspect-ratio:1326/183}.earth-hero-copy{transform:translateY(calc(var(--hero-progress)*-100px));}.earth-hero[data-webgl-name="true"] .earth-hero-copy p{visibility:hidden}.earth-hero-copy a{top:40%}.home-handoff-line{position:fixed;z-index:10;left:-3vw;width:106vw;height:140px;top:var(--home-handoff-line-y,100vh);transform:translateY(-50%);pointer-events:none;opacity:var(--home-handoff-line-opacity,0);backdrop-filter:var(--home-handoff-filter,none);mask-image:linear-gradient(to bottom,transparent,#000 38%,#000 62%,transparent)}@media(prefers-reduced-motion:reduce){.home-handoff-line{display:none}}.earth-hero-copy p img{display:block;width:clamp(180px,18vw,250px);height:auto;filter:drop-shadow(0 0 12px #3166af)}</style>


