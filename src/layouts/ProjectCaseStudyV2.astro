---
import PortfolioHeader from '../components/PortfolioHeader.astro';
import ProjectFooter from '../components/ProjectFooter.astro';
import {ClientRouter} from 'astro:transitions';
import PortfolioAudio from '../components/PortfolioAudio.astro';
import '../styles/project-pages-v2.css';
import '../styles/responsive.css';
import SeoHead from '../components/SeoHead.astro';
import {projects} from '../data/projects.js';
const { title, background } = Astro.props;
const slug = Astro.url.pathname.split('/').filter(Boolean).pop();
const description = projects.find(project => project.slug === slug)?.description ?? `${title} — Projet de Clément Bertrand`;
---
<!doctype html>
<html lang="fr">
  <head><ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Clément Bertrand</title>
    <SeoHead title={`${title} — Clément Bertrand`} description={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=sparky-head-2" /><link rel="icon" type="image/png" sizes="64x64" href="/favicon.png?v=sparky-head-2" />
    <link rel="preload" href="/fonts/les-murmures/le-murmure.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/project-pages/mabry-pro-light.ttf" as="font" type="font/ttf" crossorigin />
  
</head>
  <body style={`--project-background:${background}`}>
    <main class="v2-shell"><h1 class="sr-only">{title}</h1><slot /></main>
    <script is:inline data-astro-rerun>
      // Size the page before first paint, so the footer does not jump when the module script scales the artboard.
      (() => {
        const shell = document.querySelector('.v2-shell'), artboard = shell && shell.querySelector('.v2-artboard');
        if (!artboard || matchMedia('(max-width: 900px)').matches) return;
        const scale = shell.clientWidth / 1440;
        artboard.style.transform = 'scale(' + scale + ')';
        shell.style.height = Number(artboard.dataset.designHeight) * scale + 'px';
      })();
    </script>
  <ProjectFooter title={title} /><PortfolioHeader /><PortfolioAudio /></body>
</html>
<script>
import {mountResponsiveProject} from '../lib/responsive-project.js';
let observer: ResizeObserver | undefined;
let disposeResponsive: (() => void) | undefined;
function fitProjectPage() {
observer?.disconnect();
disposeResponsive?.();
const shell = document.querySelector<HTMLElement>('.v2-shell');
const artboard = shell?.querySelector<HTMLElement>('.v2-artboard');
if (shell && artboard) {
  disposeResponsive = mountResponsiveProject(shell, artboard);
  const fit = () => {
    if (matchMedia('(max-width: 900px)').matches) { artboard.style.transform = 'none'; shell.style.height = 'auto'; return; }
    const scale = shell.clientWidth / 1440;
    artboard.style.transform = `scale(${scale})`;
    shell.style.height = `${Number(artboard.dataset.designHeight) * scale}px`;
  };
  observer = new ResizeObserver(fit);
  observer.observe(shell);
  fit();
}
}
fitProjectPage();
document.addEventListener('astro:page-load', fitProjectPage);
document.addEventListener('astro:before-swap', () => { observer?.disconnect(); disposeResponsive?.(); });
</script>
