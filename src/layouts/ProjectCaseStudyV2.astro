---
import '../styles/project-pages-v2.css';
const { title, background } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${title} — Projet de Clément Bertrand`} />
    <title>{title} — Clément Bertrand</title>
    <link rel="icon" href="/favicon.svg" />
    <link rel="preload" href="/fonts/les-murmures/le-murmure.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/fonts/project-pages/mabry-pro-light.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body style={`--project-background:${background}`}>
    <main class="v2-shell"><h1 class="sr-only">{title}</h1><slot /></main>
  </body>
</html>
<script>
const shell = document.querySelector<HTMLElement>('.v2-shell');
const artboard = shell?.querySelector<HTMLElement>('.v2-artboard');
if (shell && artboard) {
  const fit = () => {
    const scale = shell.clientWidth / 1440;
    artboard.style.transform = `scale(${scale})`;
    shell.style.height = `${Number(artboard.dataset.designHeight) * scale}px`;
  };
  new ResizeObserver(fit).observe(shell);
  fit();
}
</script>
