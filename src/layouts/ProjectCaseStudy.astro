---
import PortfolioHeader from '../components/PortfolioHeader.astro';
import {ClientRouter} from 'astro:transitions';
import PortfolioAudio from '../components/PortfolioAudio.astro';
import '../styles/project-pages.css';
import SeoHead from '../components/SeoHead.astro';
import {projects} from '../data/projects.js';
const { title, background } = Astro.props;
const slug = Astro.url.pathname.split('/').filter(Boolean).pop();
const description = projects.find(project => project.slug === slug)?.description ?? title+' — Projet de Clément Bertrand';
import '../styles/responsive.css';
---
<!doctype html><html lang="fr"><head><ClientRouter /><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} — Clément Bertrand</title><SeoHead title={title+' — Clément Bertrand'} description={description} /><link rel="icon" type="image/svg+xml" href="/favicon.svg?v=sparky-head-2" /><link rel="icon" type="image/png" sizes="64x64" href="/favicon.png?v=sparky-head-2" /><link rel="preload" href="/fonts/les-murmures/le-murmure.otf" as="font" type="font/otf" crossorigin/><link rel="preload" href="/fonts/project-pages/lexend-regular.ttf" as="font" type="font/ttf" crossorigin/>
</head><body style={`--project-background:${background}`}><main class="project-shell"><h1 class="sr-only">{title}</h1><slot/></main><PortfolioHeader /><PortfolioAudio /></body></html>
<script>
const shell=document.querySelector<HTMLElement>('.project-shell');
if(shell){const artboards=[...shell.querySelectorAll<HTMLElement>('.project-artboard')];const fit=()=>{const mobile=matchMedia('(max-width:700px)').matches;const active=artboards.find(a=>a.classList.contains(mobile?'mobile':'desktop'));if(!active)return;const width=Number(active.dataset.designWidth),height=Number(active.dataset.designHeight),scale=shell.clientWidth/width;active.style.transform=`scale(${scale})`;shell.style.height=`${height*scale}px`;};new ResizeObserver(fit).observe(shell);fit();}
</script>
